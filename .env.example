EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to 1 only when firebase emulators are running.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=0

# Android emulator reaches the host at 10.0.2.2. A physical device needs the computer's LAN address.
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# Cloudinary unsigned upload. Do not put the API secret here.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=ywtmy20w
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=dataExpense
